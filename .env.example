# Environment variable template. Copy it to `.env` for local use:
#   cp .env.example .env
#
# Ollama model to download at startup.
# Options: gemma2:2b, gemma3:270m, gemma3:1b, gemma3:4b, llama3.2:3b, ...
OLLAMA_MODEL=llama3.2:3b

# BERT model for anonymization (gated Hugging Face repo).
# The local folder under models/ is the last part of the repo id.
BERT_MODEL=PlanTL-GOB-ES/bsc-bio-ehr-es-carmen-anon

# Optional SHA-256 of the BERT weights file (pytorch_model.bin or
# model.safetensors) to detect tampering. Empty = skip the check.
BERT_MODEL_SHA256=

# Public URL of the remote proxy (Sliplane) used by the local client.
REMOTE_URL=https://your-app.sliplane.app

# Local port where `local_ollama.py` mimics Ollama (default 11434).
LOCAL_PORT=11434

# Shared secret to encrypt the client <-> server communication.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# It must be the same on the client and the server.
ENCRYPTION_SECRET=

# Basic authentication (user/password) for the proxy. Leave empty to disable.
# Credentials travel encrypted (double encryption): their key is derived from
# OLLAMA_MODEL + BERT_MODEL + AUTH_PASSWORD, so client and server must share
# the same values for all three.
AUTH_USER=admin
AUTH_PASSWORD=

# Allowed IPs (comma-separated; CIDR supported). Empty = no restriction.
ALLOWED_IPS=

# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated
# IPs/CIDRs). The proxy only honors X-Forwarded-For from these peers.
TRUSTED_PROXIES=

# Requests per minute allowed per client IP (0 = no limit).
RATE_LIMIT=0

# Optional JSON-lines audit log path (server side). Empty = disabled.
AUDIT_LOG=
