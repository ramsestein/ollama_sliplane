# Plantilla de variables de entorno. Cópiala a `.env` para uso local:
#   cp .env.example .env
#
# Modelo que descargará Ollama al arrancar.
# Opciones: gemma2:2b, gemma3:270m, gemma3:1b, gemma3:4b, llama3.2:3b, ...
OLLAMA_MODEL=gemma2:2b

# Secreto compartido para cifrar la comunicación cliente <-> servidor.
# Genera uno con:  python -c "import secrets; print(secrets.token_hex(32))"
# Debe ser el mismo en el cliente y en el servidor.
ENCRYPTION_SECRET=

# Autenticación básica (usuario/contraseña) para el proxy. Déjalos vacíos para desactivar.
AUTH_USER=admin
AUTH_PASSWORD=

# IPs permitidas (separadas por comas; admite CIDR). Vacío = sin restricción.
ALLOWED_IPS=
