# Environment variable template. Copy it to `.env` for local use:
#   cp .env.example .env
#
# Ollama model to download at startup.
# Options: gemma2:2b, gemma3:270m, gemma3:1b, gemma3:4b, llama3.2:3b, ...
OLLAMA_MODEL=llama3.2:3b

# BERT model for anonymization (gated Hugging Face repo).
# The local folder under models/ is the last part of the repo id.
BERT_MODEL=BSC-NLP4BIA/bsc-bio-ehr-es-carmen-anon

# Git revision (commit hash) of the BERT model repo, pinned for reproducibility.
BERT_MODEL_REVISION=83db1112c37c7ef527a9ba6d6b4d1be18b4bca9b

# SHA-256 of the BERT weights file (model.safetensors). Empty = skip the check.
# The value below is the LFS oid of model.safetensors at the revision above.
BERT_MODEL_SHA256=883c7c2c63d01da8af3ea12a8b22237f2896b0ce

# Public URL of the remote proxy (Sliplane) used by the local client.
REMOTE_URL=https://your-app.sliplane.app

# Local port where `local_ollama.py` mimics Ollama (default 11434).
LOCAL_PORT=11434

# Shared pre-shared key (PSK) for the client <-> server channel (protocol v2).
# Generate one with:  python -m src.keygen
# It is a base64 string that decodes to >= 32 random bytes. It must be the
# same on the client and the server. NOTE: PSK means no forward secrecy.
ENCRYPTION_SECRET=

# Credentials (user/password). They travel INSIDE the encrypted payload and are
# compared in constant time by the proxy. Leave empty to disable.
AUTH_USER=admin
AUTH_PASSWORD=

# Allowed IPs (comma-separated; CIDR supported). Empty = no restriction.
ALLOWED_IPS=

# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated
# IPs/CIDRs). The proxy only honors X-Forwarded-For from these peers.
TRUSTED_PROXIES=

# Requests per minute allowed per client IP (0 = no limit).
RATE_LIMIT=0

# Maximum clock skew (seconds) accepted between client and server.
MAX_SKEW=120

# Anti-replay cache TTL (seconds). Must be >= 2 * MAX_SKEW; lower values are
# raised automatically.
REPLAY_TTL=300

# Maximum number of remembered request ids; the cache fails closed when full.
REPLAY_MAX_ENTRIES=100000

# Optional JSON-lines audit log path (server side). Empty = disabled.
AUDIT_LOG=

